# Copie para .env.local e preencha. NUNCA versione o .env.local.

# --- E-mail (SMTP) ---
# Gmail: use uma "Senha de app" (myaccount.google.com/apppasswords), não a senha normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
CONTATO_EMAIL_DESTINO=destino@exemplo.com

# --- WhatsApp (CallMeBot, gratuito) ---
# Do celular que vai RECEBER, adicione +34 644 71 81 99 nos contatos e envie
# "I allow callmebot to send me messages". A API key chega por WhatsApp.
CALLMEBOT_APIKEY=
CONTATO_WHATSAPP_DESTINO=5585900000000
